msgid ""
"<strong>KPI cards</strong> — Total teams, active players, upcoming events, "
"monthly income &amp; expenses."
msgstr ""
"<strong>Tarjetas KPI</strong> — Equipos totales, jugadores activos, eventos "
"próximos, ingresos &amp; gastos mensuales."

msgid ""
"<strong>Recent activity feed</strong> — Latest updates across all modules."
msgstr ""
"<strong>Feed de actividad reciente</strong> — Últimas actualizaciones en "
"todos los módulos."

msgid "<strong>Quick links</strong> — Jump straight to any module."
msgstr ""
"<strong>Accesos rápidos</strong> — Ve directamente a cualquier módulo."

msgid ""
"Use the Dashboard as a <strong>daily check-in</strong> — review the KPIs "
"each morning to stay on top of your club's pulse."
msgstr ""
"Usa el Panel como un <strong>chequeo diario</strong> — revisa los KPI cada "
"mañana para estar al tanto del estado de tu club."

msgid ""
"The numbers update in <strong>real time</strong> as you add data in other "
"modules."
msgstr ""
"Los números se actualizan en <strong>tiempo real</strong> a medida que "
"añades datos en otros módulos."

msgid ""
"<strong>Player cards</strong> — Name, photo, position, team, and current "
"status."
msgstr ""
"<strong>Fichas de jugadores</strong> — Nombre, foto, posición, equipo y "
"estado actual."

msgid ""
"<strong>Search &amp; filter</strong> — Find players by name, position, team,"
" or status."
msgstr ""
"<strong>Buscar &amp; filtrar</strong> — Encuentra jugadores por nombre, "
"posición, equipo o estado."

msgid ""
"<strong>Quick-add button</strong> — Add a new player without leaving the "
"list."
msgstr ""
"<strong>Botón de añadir rápido</strong> — Añade un nuevo jugador sin salir "
"de la lista."

msgid ""
"Fill in the <strong>required fields</strong> (name, sport, position) and add"
" optional details like photo, DOB, and nationality."
msgstr ""
"Rellena los <strong>campos requeridos</strong> (nombre, deporte, posición) y"
" añade detalles opcionales como foto, fecha de nacimiento y nacionalidad."

msgid ""
"You can always <strong>edit</strong> a player profile later to add more "
"information."
msgstr ""
"Siempre puedes <strong>editar</strong> un perfil de jugador más adelante "
"para añadir más información."

msgid "<strong>Edit</strong> — Update the player's profile."
msgstr "<strong>Editar</strong> — Actualizar el perfil del jugador."

msgid ""
"<strong>Assign to Team</strong> — Link the player to one or more teams."
msgstr ""
"<strong>Asignar a equipo</strong> — Vincular el jugador a uno o más equipos."

msgid "<strong>Log Medical</strong> — Record an injury or health update."
msgstr ""
"<strong>Registro médico</strong> — Registrar una lesión o actualización de "
"salud."

msgid ""
"<strong>Create Contract</strong> — Start a new contract directly from the "
"player's page."
msgstr ""
"<strong>Crear contrato</strong> — Iniciar un nuevo contrato directamente "
"desde la página del jugador."

msgid ""
"<strong>Delete</strong> — Permanently remove the player (use with care)."
msgstr ""
"<strong>Eliminar</strong> — Eliminar permanentemente al jugador (usar con "
"precaución)."

msgid ""
"Keep player <strong>status</strong> up to date (Active, Injured, On Loan, "
"etc.) so reports and filters stay accurate."
msgstr ""
"Mantén el <strong>estado</strong> del jugador actualizado (Activo, "
"Lesionado, Cedido, etc.) para que los informes y filtros sean precisos."

msgid ""
"Use the <strong>notes field</strong> for any free-form observations about a "
"player."
msgstr ""
"Usa el <strong>campo de notas</strong> para cualquier observación en texto "
"libre sobre un jugador."

msgid ""
"<strong>Team cards</strong> — Name, sport, type, head coach, and player "
"count."
msgstr ""
"<strong>Fichas de equipo</strong> — Nombre, deporte, tipo, entrenador "
"principal y número de jugadores."

msgid ""
"<strong>Filter by sport or type</strong> — Narrow down the list quickly."
msgstr ""
"<strong>Filtrar por deporte o tipo</strong> — Reduce la lista rápidamente."

msgid ""
"Give each team a <strong>unique name</strong> and select the sport and team "
"type to keep your data organised."
msgstr ""
"Dale a cada equipo un <strong>nombre único</strong> y selecciona el deporte "
"y el tipo de equipo para mantener tus datos organizados."

msgid "<strong>Edit</strong> — Update team details."
msgstr "<strong>Editar</strong> — Actualizar los detalles del equipo."

msgid "<strong>Manage Roster</strong> — Add or remove players from the team."
msgstr ""
"<strong>Gestionar plantilla</strong> — Añadir o eliminar jugadores del "
"equipo."

msgid ""
"<strong>View Schedule</strong> — See upcoming events linked to this team."
msgstr ""
"<strong>Ver calendario</strong> — Ver los próximos eventos vinculados a este"
" equipo."

msgid "<strong>Delete</strong> — Remove the team (players are not deleted)."
msgstr ""
"<strong>Eliminar</strong> — Eliminar el equipo (los jugadores no se "
"eliminan)."

msgid ""
"Assign a <strong>head coach</strong> from your staff list to each team for "
"clear accountability."
msgstr ""
"Asigna un <strong>entrenador principal</strong> de tu lista de personal a "
"cada equipo para una responsabilidad clara."

msgid ""
"<strong>Event cards</strong> — Title, type, date/time, location, and linked "
"team."
msgstr ""
"<strong>Fichas de eventos</strong> — Título, tipo, fecha/hora, ubicación y "
"equipo vinculado."

msgid ""
"<strong>Calendar view</strong> — See all events in a monthly or weekly "
"layout."
msgstr ""
"<strong>Vista de calendario</strong> — Ver todos los eventos en formato "
"mensual o semanal."

msgid ""
"<strong>Filter by type or team</strong> — Focus on specific activities."
msgstr ""
"<strong>Filtrar por tipo o equipo</strong> — Céntrate en actividades "
"específicas."

msgid ""
"Set a clear <strong>start and end time</strong> for every event so the "
"calendar stays readable."
msgstr ""
"Establece una <strong>hora de inicio y fin</strong> clara para cada evento "
"para que el calendario sea legible."

msgid ""
"Link events to <strong>teams</strong> so players can see what's relevant to "
"them."
msgstr ""
"Vincula los eventos a <strong>equipos</strong> para que los jugadores puedan"
" ver lo que les concierne."

msgid "<strong>Edit</strong> — Change event details."
msgstr "<strong>Editar</strong> — Cambiar los detalles del evento."

msgid "<strong>Add Result</strong> — Log the outcome for match events."
msgstr ""
"<strong>Añadir resultado</strong> — Registrar el resultado para los eventos "
"de partido."

msgid "<strong>Delete</strong> — Remove the event."
msgstr "<strong>Eliminar</strong> — Eliminar el evento."

msgid ""
"Use the <strong>notes field</strong> on an event to record key talking "
"points or post-match observations."
msgstr ""
"Usa el <strong>campo de notas</strong> en un evento para registrar puntos "
"clave o observaciones post-partido."

msgid ""
"<strong>Tournament cards</strong> — Name, type, sport, season, and status."
msgstr ""
"<strong>Fichas de torneos</strong> — Nombre, tipo, deporte, temporada y "
"estado."

msgid ""
"<strong>Filter by type or status</strong> — Find active or past competitions"
" easily."
msgstr ""
"<strong>Filtrar por tipo o estado</strong> — Encuentra fácilmente "
"competiciones activas o pasadas."

msgid ""
"Set the <strong>season</strong> field so you can look back at past "
"tournaments year by year."
msgstr ""
"Rellena el campo <strong>temporada</strong> para poder consultar los torneos"
" pasados año a año."

msgid "<strong>Edit</strong> — Update tournament details."
msgstr "<strong>Editar</strong> — Actualizar los detalles del torneo."

msgid "<strong>Add Fixture</strong> — Schedule a match within the tournament."
msgstr ""
"<strong>Añadir partido</strong> — Programar un partido dentro del torneo."

msgid ""
"<strong>View Standings</strong> — See the current league table or bracket."
msgstr "<strong>Ver clasificación</strong> — Ver la tabla o cuadro actual."

msgid "<strong>Delete</strong> — Remove the tournament and its fixtures."
msgstr "<strong>Eliminar</strong> — Eliminar el torneo y sus partidos."

msgid ""
"Link tournaments to <strong>teams</strong> and <strong>events</strong> for a"
" complete competition picture."
msgstr ""
"Vincula los torneos a <strong>equipos</strong> y <strong>eventos</strong> "
"para una visión completa de las competiciones."

msgid ""
"<strong>Contract cards</strong> — Party name, type, start/end dates, and "
"status."
msgstr ""
"<strong>Fichas de contratos</strong> — Nombre de la parte, tipo, fechas de "
"inicio/fin y estado."

msgid ""
"<strong>Filter by type or status</strong> — Quickly find active or expiring "
"contracts."
msgstr ""
"<strong>Filtrar por tipo o estado</strong> — Encuentra rápidamente contratos"
" activos o que vencen pronto."

msgid ""
"Set <strong>start and end dates</strong> carefully — the system uses these "
"for expiry alerts."
msgstr ""
"Establece las <strong>fechas de inicio y fin</strong> con cuidado — el "
"sistema las usa para las alertas de vencimiento."

msgid "<strong>Edit</strong> — Modify contract terms."
msgstr "<strong>Editar</strong> — Modificar los términos del contrato."

msgid "<strong>Download PDF</strong> — Export the contract as a document."
msgstr "<strong>Descargar PDF</strong> — Exportar el contrato como documento."

msgid ""
"<strong>Terminate</strong> — Mark a contract as ended before its expiry "
"date."
msgstr ""
"<strong>Rescindir</strong> — Marcar un contrato como terminado antes de su "
"fecha de vencimiento."

msgid "<strong>Delete</strong> — Permanently remove the contract record."
msgstr ""
"<strong>Eliminar</strong> — Eliminar permanentemente el registro del "
"contrato."

msgid ""
"Use the <strong>notes field</strong> to record any special clauses or "
"conditions."
msgstr ""
"Usa el <strong>campo de notas</strong> para registrar cualquier cláusula o "
"condición especial."

msgid ""
"<strong>Staff cards</strong> — Name, role, team assignment, and contact "
"info."
msgstr ""
"<strong>Fichas de personal</strong> — Nombre, rol, asignación de equipo e "
"información de contacto."

msgid ""
"<strong>Filter by role or team</strong> — Find the right person quickly."
msgstr ""
"<strong>Filtrar por rol o equipo</strong> — Encuentra a la persona adecuada "
"rápidamente."

msgid ""
"Fill in the <strong>role/position</strong> field accurately — it's used to "
"filter staff when assigning coaches and medical personnel."
msgstr ""
"Rellena con precisión el campo <strong>rol/posición</strong> — se usa para "
"filtrar personal al asignar entrenadores y personal médico."

msgid "<strong>Edit</strong> — Update staff details."
msgstr "<strong>Editar</strong> — Actualizar los detalles del personal."

msgid ""
"<strong>Assign to Team</strong> — Link the staff member to one or more "
"teams."
msgstr ""
"<strong>Asignar a equipo</strong> — Vincular el miembro del personal a uno o"
" más equipos."

msgid ""
"<strong>Create Contract</strong> — Start a staff contract from the staff "
"detail page."
msgstr ""
"<strong>Crear contrato</strong> — Iniciar un contrato de personal desde la "
"página de detalle."

msgid "<strong>Delete</strong> — Remove the staff record."
msgstr "<strong>Eliminar</strong> — Eliminar el registro del personal."

msgid ""
"<strong>Medical records</strong> — Player name, record type, diagnosis, and "
"status."
msgstr ""
"<strong>Registros médicos</strong> — Nombre del jugador, tipo de registro, "
"diagnóstico y estado."

msgid ""
"<strong>Filter by player or type</strong> — Find injury histories quickly."
msgstr ""
"<strong>Filtrar por jugador o tipo</strong> — Encuentra historiales de "
"lesiones rápidamente."

msgid ""
"<strong>Status indicator</strong> — See at a glance who is fit, injured, or "
"recovering."
msgstr ""
"<strong>Indicador de estado</strong> — Ve de un vistazo quién está en forma,"
" lesionado o recuperándose."

msgid ""
"Always set an <strong>estimated return date</strong> for injured players — "
"it keeps the medical dashboard accurate."
msgstr ""
"Establece siempre una <strong>fecha de regreso estimada</strong> para los "
"jugadores lesionados — mantiene el panel médico preciso."

msgid "<strong>Edit</strong> — Update the medical record."
msgstr "<strong>Editar</strong> — Actualizar el registro médico."

msgid ""
"<strong>Resolve</strong> — Mark the record as resolved when the player is "
"fit."
msgstr ""
"<strong>Resolver</strong> — Marcar el registro como resuelto cuando el "
"jugador esté en forma."

msgid "<strong>Delete</strong> — Remove the medical record."
msgstr "<strong>Eliminar</strong> — Eliminar el registro médico."

msgid ""
"Keep records <strong>up to date</strong> — resolved injuries still appear in"
" the player's history for reference."
msgstr ""
"Mantén los registros <strong>actualizados</strong> — las lesiones resueltas "
"siguen apareciendo en el historial del jugador como referencia."

msgid ""
"<strong>KPI cards</strong> — Total income, total expenses, net balance, and "
"pending transactions."
msgstr ""
"<strong>Tarjetas KPI</strong> — Ingresos totales, gastos totales, saldo neto"
" y transacciones pendientes."

msgid ""
"<strong>Transaction list</strong> — All income and expense entries with "
"date, category, and amount."
msgstr ""
"<strong>Lista de transacciones</strong> — Todas las entradas de ingresos y "
"gastos con fecha, categoría e importe."

msgid ""
"<strong>Charts</strong> — Visual breakdown of income vs expenses over time."
msgstr ""
"<strong>Gráficos</strong> — Desglose visual de ingresos frente a gastos a lo"
" largo del tiempo."

msgid ""
"Categorise every transaction — it makes the <strong>charts and "
"reports</strong> much more useful."
msgstr ""
"Categoriza cada transacción — hace que los <strong>gráficos e "
"informes</strong> sean mucho más útiles."

msgid ""
"Use <strong>consistent category names</strong> (e.g., always 'Wages' not "
"sometimes 'Salary') for clean reporting."
msgstr ""
"Usa <strong>nombres de categoría coherentes</strong> (ej. siempre 'Salarios'"
" y no a veces 'Sueldo') para informes limpios."

msgid "<strong>Edit</strong> — Correct a transaction's details."
msgstr "<strong>Editar</strong> — Corregir los detalles de una transacción."

msgid "<strong>Delete</strong> — Remove a transaction record."
msgstr "<strong>Eliminar</strong> — Eliminar un registro de transacción."

msgid ""
"<strong>Inventory cards</strong> — Item name, type, quantity, condition, and"
" assigned-to."
msgstr ""
"<strong>Fichas de inventario</strong> — Nombre del artículo, tipo, cantidad,"
" estado y asignado a."

msgid "<strong>Filter by type or condition</strong> — Locate items quickly."
msgstr ""
"<strong>Filtrar por tipo o estado</strong> — Localiza artículos rápidamente."

msgid ""
"Use the <strong>condition</strong> field to flag items that need replacing "
"soon."
msgstr ""
"Usa el campo <strong>estado</strong> para marcar artículos que necesiten "
"reemplazarse pronto."

msgid "<strong>Edit</strong> — Update item details or quantity."
msgstr ""
"<strong>Editar</strong> — Actualizar los detalles o cantidad de un artículo."

msgid "<strong>Assign</strong> — Link an item to a player or team."
msgstr ""
"<strong>Asignar</strong> — Vincular un artículo a un jugador o equipo."

msgid "<strong>Delete</strong> — Remove the inventory record."
msgstr "<strong>Eliminar</strong> — Eliminar el registro del inventario."

msgid ""
"<strong>Scout report cards</strong> — Player name, scout, rating, and "
"recommendation."
msgstr ""
"<strong>Fichas de informes de scouting</strong> — Nombre del jugador, scout,"
" valoración y recomendación."

msgid "<strong>Filter by recommendation</strong> — Focus on top targets."
msgstr ""
"<strong>Filtrar por recomendación</strong> — Céntrate en los mejores "
"objetivos."

msgid ""
"Be specific in the <strong>strengths and weaknesses</strong> fields — vague "
"notes lose value over time."
msgstr ""
"Sé específico en los campos de <strong>fortalezas y debilidades</strong> — "
"las notas vagas pierden valor con el tiempo."

msgid "<strong>Edit</strong> — Update the scout report."
msgstr "<strong>Editar</strong> — Actualizar el informe de scouting."

msgid ""
"<strong>Convert to Player</strong> — Add a scouted prospect directly to your"
" player database."
msgstr ""
"<strong>Convertir en jugador</strong> — Añadir un prospecto evaluado "
"directamente a tu base de jugadores."

msgid "<strong>Delete</strong> — Remove the scout report."
msgstr "<strong>Eliminar</strong> — Eliminar el informe de scouting."

msgid ""
"<strong>Organization cards</strong> — Name, type, country, and contact info."
msgstr ""
"<strong>Fichas de organizaciones</strong> — Nombre, tipo, país e información"
" de contacto."

msgid ""
"<strong>Filter by type or country</strong> — Find relevant bodies quickly."
msgstr ""
"<strong>Filtrar por tipo o país</strong> — Encuentra organismos relevantes "
"rápidamente."

msgid ""
"Add <strong>contact details</strong> for each organization so your staff "
"always know who to reach."
msgstr ""
"Añade los <strong>datos de contacto</strong> de cada organización para que "
"tu personal siempre sepa a quién dirigirse."

msgid "<strong>Edit</strong> — Update organization details."
msgstr "<strong>Editar</strong> — Actualizar los detalles de la organización."

msgid "<strong>Delete</strong> — Remove the organization record."
msgstr "<strong>Eliminar</strong> — Eliminar el registro de la organización."

msgid ""
"<strong>Academy programs</strong> — Name, age group, assigned coach, and "
"status."
msgstr ""
"<strong>Programas de academia</strong> — Nombre, grupo de edad, entrenador "
"asignado y estado."

msgid ""
"<strong>Development plans</strong> — Individual goals and milestones for "
"each academy player."
msgstr ""
"<strong>Planes de desarrollo</strong> — Objetivos individuales e hitos para "
"cada jugador de la academia."

msgid ""
"<strong>Progress tracking</strong> — Visual milestones showing each player's"
" development journey."
msgstr ""
"<strong>Seguimiento del progreso</strong> — Hitos visuales que muestran el "
"recorrido de desarrollo de cada jugador."

msgid ""
"Assign every academy player a <strong>development plan</strong> to keep "
"their progress structured and measurable."
msgstr ""
"Asigna a cada jugador de la academia un <strong>plan de desarrollo</strong> "
"para mantener su progreso estructurado y medible."

msgid ""
"<strong>Campaigns</strong> — Active and past marketing campaigns with goals "
"and results."
msgstr ""
"<strong>Campañas</strong> — Campañas de marketing activas y pasadas con "
"objetivos y resultados."

msgid ""
"<strong>Sponsorships</strong> — Partner brands, deal values, and contract "
"periods."
msgstr ""
"<strong>Patrocinios</strong> — Marcas asociadas, valores del acuerdo y "
"períodos de contrato."

msgid ""
"<strong>Announcements</strong> — Club news and updates published to fans."
msgstr ""
"<strong>Anuncios</strong> — Noticias y actualizaciones del club publicadas a"
" los aficionados."

msgid ""
"Keep your <strong>sponsorship records</strong> up to date — expiring deals "
"show up in contract alerts."
msgstr ""
"Mantén tus <strong>registros de patrocinio</strong> actualizados — los "
"acuerdos que vencen aparecen en las alertas de contrato."

msgid ""
