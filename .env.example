DEBUG=True
SECRET_KEY=your-super-secret-key-change-in-production-minimum-50-chars
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (SQLite default; switch to postgres in production)
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgres://user:password@localhost:5432/apexforge

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=ApexForge <noreply@apexforge.com>

# Media / Storage
MEDIA_URL=/media/
MEDIA_ROOT=media

# Static
STATIC_URL=/static/
STATIC_ROOT=staticfiles

# Timezone & Language
LANGUAGE_CODE=en
TIME_ZONE=UTC
